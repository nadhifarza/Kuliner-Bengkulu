{% extends 'store/base.html' %}{% load kb_filters %}{% block title %}Metode Pembayaran | Kuliner Bengkulu{% endblock %}{% block content %}<div class="breadcrumb">Checkout / Metode Pembayaran</div><div class="narrow"><h1>Pilih Pembayaran</h1><p class="muted">Pesanan {{ order.code }} · Total Rp {{ order.total }}</p><form method="post" class="panel">{% csrf_token %}<label class="payment-option"><input type="radio" name="method" value="BANK_TRANSFER" {% if payment.method == 'BANK_TRANSFER' %}checked{% endif %}><span><b>Transfer Bank</b><small>Melalui payment gateway yang akan dikonfigurasi.</small></span><strong>⇢</strong></label><label class="payment-option"><input type="radio" name="method" value="QRIS" {% if payment.method == 'QRIS' %}checked{% endif %}><span><b>QRIS</b><small>Pembayaran QRIS melalui payment gateway.</small></span><strong>▦</strong></label><button class="btn btn-primary full">Lanjutkan</button></form></div>{% endblock %}
