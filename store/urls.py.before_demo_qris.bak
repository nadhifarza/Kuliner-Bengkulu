 path('notifikasi/',views.notifications,name='notifications'),path('informasi/<slug:slug>/',views.info_page,name='info_page'),path('webhook/payment/',views.payment_webhook,name='payment_webhook'),
 path('pengelola/',views.admin_dashboard,name='admin_dashboard'),path('pengelola/produk/',views.admin_products,name='admin_products'),path('pengelola/produk/tambah/',views.admin_product_form,name='admin_product_add'),path('pengelola/produk/<int:pk>/ubah/',views.admin_product_form,name='admin_product_edit'),path('pengelola/produk/<int:pk>/hapus/',views.admin_product_delete,name='admin_product_delete'),
 path('pengelola/kategori/',views.admin_categories,name='admin_categories'),path('pengelola/kategori/<int:pk>/hapus/',views.admin_category_delete,name='admin_category_delete'),path('pengelola/pegawai/',views.admin_employees,name='admin_employees'),path('pengelola/pegawai/tambah/',views.admin_employee_form,name='admin_employee_add'),
 path('pengelola/laporan/<slug:kind>/',views.admin_reports,name='admin_reports'),path('pengelola/ekspor/<str:fmt>/',views.export_report,name='export_report'),path('pengelola/profil-usaha/',views.admin_business,name='admin_business'),path('pengelola/banner/',views.admin_banners,name='admin_banners'),path('pengelola/banner/tambah/',views.admin_banner_form,name='admin_banner_add'),path('pengelola/banner/<int:pk>/ubah/',views.admin_banner_form,name='admin_banner_edit'),path('pengelola/banner/<int:pk>/hapus/',views.admin_banner_delete,name='admin_banner_delete'),
