 path('checkout/',views.checkout,name='checkout'),path('pembayaran/<str:code>/',views.payment_select,name='payment_select'),path('pembayaran/<str:code>/detail/',views.payment_detail,name='payment_detail'),
 path('pesanan/',views.order_history,name='order_history'),path('pesanan/<str:code>/',views.order_detail,name='order_detail'),path('pesanan/<str:code>/batal/',views.cancel_order,name='cancel_order'),
